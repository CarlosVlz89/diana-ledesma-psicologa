rules_version = '2';

// ===============================================================
// Reglas de Seguridad de Cloud Firestore (Zero-Trust)
// Proyecto: Diana Ledesma | Psicología Clínica (diana-psicologia)
// ===============================================================
//
// Assumed Data Model
// ------------------
// Collection: blog_posts
// Document ID: {postId} (Identificador único autogenerado de Firestore)
// Fields:
//   - title: string (requerido, 5 a 200 caracteres) - Título del artículo
//   - content: string (requerido, 20 a 50,000 caracteres) - Contenido del artículo
//   - category: string (opcional, 1 a 50 caracteres) - Categoría temática
//   - imageUrl: string (opcional, 0 a 2048 caracteres) - URL de la imagen de portada
//   - author: string (opcional, 1 a 100 caracteres) - Nombre de la autora
//   - authorId: string (opcional, 1 a 128 caracteres) - UID del usuario autenticado
//   - createdAt: timestamp (requerido en creación con request.time, inmutable en actualización)
//   - updatedAt: timestamp (opcional en creación, requerido en actualización con request.time)
//
// Invariantes de Seguridad:
// 1. Default Deny: Bloqueo absoluto de cualquier ruta o colección no declarada explícitamente.
// 2. Lectura Pública: Acceso de lectura irrestricto (get y list) para blog_posts, permitiendo
//    la consulta de artículos de psicoeducación pública a pacientes y visitantes anónimos.
// 3. Control de Acceso (RBAC Zero-Trust): Únicamente administradoras autorizadas y con email
//    verificado por el proveedor de identidad pueden mutar datos (crear, editar o eliminar).
// 4. Validator Function Pattern: Se aplica isValidBlogPost() obligatoriamente tanto en create
//    como en update para erradicar el vector de ataque de Update Bypass.
// 5. Inmutabilidad Temporal: createdAt no puede ser manipulado ni alterado en actualizaciones.
// 6. Mitigación de Agotamiento de Recursos (DoS): Límites superiores estrictos de longitud
//    en todas las cadenas de texto para evitar ataques de carga masiva.
// 7. Esquema Estricto: Rechazo de cualquier campo adicional o no autorizado (hasOnly).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Funciones Auxiliares de Autenticación y Autorización
    // ===============================================================

    // Verifica si la solicitud proviene de un usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario autenticado pertenece a la lista de administradoras autorizadas
    // y posee su correo electrónico debidamente verificado por el proveedor de identidad
    function isPsychologistAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'carlos.mtzvelez@gmail.com',
          'dianaledesma@gmail.com'
        ];
    }

    // ===============================================================
    // Validadores de Estructura y Esquema de Datos
    // ===============================================================

    // Valida que el documento contenga exclusivamente los campos permitidos por el modelo
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Valida que todos los campos requeridos estén presentes en el documento
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Valida un campo de texto opcional respetando rangos de longitud mínima y máxima
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string &&
         data[field].size() >= minLen &&
         data[field].size() <= maxLen);
    }

    // ===============================================================
    // Validador de Dominio (Validator Function Pattern)
    // Evaluado obligatoriamente en operaciones create y update
    // ===============================================================
    function isValidBlogPost(data) {
      return hasOnlyAllowedFields(data, [
          'title',
          'content',
          'category',
          'imageUrl',
          'author',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        hasRequiredFields(data, ['title', 'content', 'createdAt']) &&
        data.title is string &&
        data.title.size() >= 5 &&
        data.title.size() <= 200 &&
        data.content is string &&
        data.content.size() >= 20 &&
        data.content.size() <= 50000 &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        isValidOptionalString(data, 'category', 1, 50) &&
        isValidOptionalString(data, 'imageUrl', 0, 2048) &&
        isValidOptionalString(data, 'author', 1, 100) &&
        isValidOptionalString(data, 'authorId', 1, 128);
    }

    // ===============================================================
    // Regla por Defecto: Bloqueo Absoluto (Zero-Trust Baseline)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Colección: blog_posts (Artículos de Psicoeducación Pública)
    // ===============================================================
    match /blog_posts/{postId} {
      // Lectura pública incondicional (get y list) para cualquier visitante anónimo o paciente
      allow read: if true;

      // Creación: Solo administradoras verificadas, con esquema estricto y sellado de createdAt
      allow create: if isPsychologistAdmin() &&
                    isValidBlogPost(request.resource.data) &&
                    request.resource.data.createdAt == request.time &&
                    (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);

      // Actualización: Solo administradoras verificadas, preservando createdAt y sellando updatedAt
      allow update: if isPsychologistAdmin() &&
                    isValidBlogPost(request.resource.data) &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    ('updatedAt' in request.resource.data) &&
                    request.resource.data.updatedAt == request.time;

      // Eliminación: Solo administradoras verificadas
      allow delete: if isPsychologistAdmin();
    }
  }
}
